FROM python:3.10-slim

WORKDIR /app

# Cài đặt curl, ca-certificates và tải docker static binary chính thức
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://download.docker.com/linux/static/stable/x86_64/docker-27.3.1.tgz | tar -xz -C /usr/local/bin --strip-components=1 docker/docker

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Sao chép mã nguồn và dữ liệu
COPY sales_api ./sales_api
COPY data ./data

EXPOSE 8088

CMD ["python", "-m", "uvicorn", "sales_api.main:app", "--host", "0.0.0.0", "--port", "8088"]
